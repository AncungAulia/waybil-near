# Public values only. Never put a secret in a NEXT_PUBLIC_* variable.

# Where the backend API lives. Server side only: the app proxies /api/* to it.
API_URL=https://api.waybil.xyz

# NEAR network, the RPC for contract views, and the contract accounts
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com
NEXT_PUBLIC_WAYBIL_CONTRACT=app.waybil.testnet
NEXT_PUBLIC_USDC_CONTRACT=usdc.waybil.testnet

# Google sign-in for drivers and warehouses (the same client id the backend uses)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Set to "on" for the live path: role guards and the real clock. Leave empty to keep the
# demo story on every screen.
NEXT_PUBLIC_LIVE=

# The public landing page, used by the logo link and the footer
NEXT_PUBLIC_LANDING_URL=

# Set to "on" to open /dev/gallery, the page that shows every component state.
# Leave empty everywhere the app is deployed.
NEXT_PUBLIC_GALLERY=
